ELASTICSEARCH_CLUSTER=elasticsearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_INDEX_NAME=lov
# true (default): indices lov_class, lov_property, ... (underscore; matches Ontology-Hub UI). false: single index "lov" with merged mappings.
# If you previously had per-type indices with a hyphen (lov-class, ...), delete them in Elasticsearch after switching; create-index only manages lov_* names.
ELASTICSEARCH_PER_TYPE_INDICES=true
# Optional: after changing mappings (e.g. date_detection), run create-index once so Elasticsearch drops old dynamic field types.
# Optional: index-lov — continue after a single document fails (default false = abort on first error).
ELASTICSEARCH_INDEX_CONTINUE_ON_ERROR=true
# If continue-on-error is true, optionally fail the process when any document was skipped (default false = lenient exit).
# ELASTICSEARCH_INDEX_FAIL_ON_SKIPPED=true
# If unset, create-index uses packaged resources under classpath mappings/. Scripts normalize known UI/legacy quirks.
# ELASTICSEARCH_MAPPINGS_PATH=/absolute/path/to/elastic/mappings
# Optional aliases: ELASTIC_SEARCH_HOST, ELASTIC_SEARCH_CLUSTER, ELASTIC_SEARCH_INDEX_NAME
# Credentials (defaults: user elastic, password OntologyHub2026 if omitted)
ELASTIC_SEARCH_USER=elastic
ELASTIC_SEARCH_PASSWORD=OntologyHub2026
MONGO_DB_HOST=mongodb
MONGO_DB_PORT=27017
MONGO_DB_INSTANCE=lov
LANGUAGES_FILE_PATH=/app/scripts/languages.rdf
LOV_DATASET_URI=http://lov_server:3333/dataset/lov
LOV_ENDPOINT=http://lov_server:8180/openrdf-sesame/repositories/lov
LOV_NQ_FILE_PATH=/app/public/lov.nq
# Empty or fresh directory for TDB bulk load (index-lov); reuse only after successful runs
LOV_TMP_DUMP_PATH=/app/tdb-tmp
LOV_RDF_FILE_PATH=/app/scripts/lov.rdf
LOV_N3_FILE_PATH=/app/public/lov.n3
METRICS_FILE_PATH=/app/scripts/lov_metrics.n3
VERSIONS_DIR_PATH=/app/versions
VERSIONS_TEMP_PATH=/app/versions/temp
